+		    &ne2d,&t0g,&t1g,irobustdesign,&irandomtype,
+		    &randomval,&prlab,&prset,&filab,&xmodal,&ielmat,
+		    &matname,&sti,&eme,&ener,&xstate,&vold,
+		    &veold,&vel,&velo,&veloo,&iponor,&xnor,
+		    &knor,&thicke,&offset,&iponoel2d,&inoel2d,&rig,
