Recognize Intel oneAPI's IntelLLVM compiler ID.

Taskflow 4.1's error message lists IntelLLVM 2022 and newer as supported,
but the compiler dispatch only handles the classic Intel ID.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -85,6 +85,12 @@ elseif (CMAKE_CXX_COMPILER_ID STREQUAL "Intel")
     message(FATAL_ERROR "\nTaskflow requires icpc at least v19.0.1")
   endif()
+elseif (CMAKE_CXX_COMPILER_ID STREQUAL "IntelLLVM")
+  if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "2022.0")
+    message(STATUS "CMAKE_CXX_COMPILER_VERSION: ${CMAKE_CXX_COMPILER_VERSION}")
+    message(FATAL_ERROR
+      "\nTaskflow requires Intel oneAPI DPC++/C++ at least v2022.0 with -std=c++20")
+  endif()
 else()
   message(FATAL_ERROR "\n\
 Taskflow currently supports the following compilers:\n\
