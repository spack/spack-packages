+#include <stdbool.h>
 #include <string.h>
 
 #include "alac_codec.h"
@@ -38,11 +39,6 @@
 #include "ALACBitUtilities.h"
 #include "EndianPortable.h"
 
-typedef enum
-{	false = 0,
-	true = 1
-} bool ;
